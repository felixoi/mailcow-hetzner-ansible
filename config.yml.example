#----------------------------------------#
#   Hetzner cloud server configuration   #
#----------------------------------------#
# Hetzner Cloud token with write access (https://console.hetzner.cloud/projects/xxxxxxx/security/tokens).
# Secrets are encrypted with Ansible Vault: replace the example with the output of
# `ansible-vault encrypt_string --stdin-name hcloud_token` (see README)
hcloud_token: !vault |
  $ANSIBLE_VAULT;1.1;AES256
  32656530363736633433306239383730316432383065363731396563393662653036646639646537
  3238346366636462373538656136663263383934643134630a346536633635633162613762356236
  62393866376639333937363363623136323563653831326366346537386631633535306636303162
  3130633664316337320a323364333765373832393437633336663339373634623362383364623234
  64666131376663303635653261613666646239333736393931613732313839333930
# Hetzner server name
server_name: mailserver
# Server type from https://docs.hetzner.com/cloud/servers/overview/#server-types
server_type: cx22
# Location from https://docs.hetzner.com/cloud/general/locations/#what-locations-are-there
server_location: nbg1
# OS image (https://docs.hetzner.com/cloud/servers/overview/#available-images).
# Only used when the server is created, an existing server is never reinstalled
server_os_image: ubuntu-26.04
# Enable Hetzner backups for the server (extra costs)
server_backups: false
# Names of Hetzner floating IPs to send and receive mail on, created if they don't exist (optional, see README)
server_floating_ipv4: ""
server_floating_ipv6: ""
# SSH keys for management access using the root user
server_ssh_keys:
  - { name: "WeirdName", key: "ssh-ed25519 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }
# Open SSH (port 22) to the whole internet in the Hetzner firewall. Not needed when connecting through a VPN
server_firewall_ssh_enabled: false
# Address Ansible connects to instead of the server's public IPv4, e.g. its WireGuard or other VPN address
server_ssh_address:
# Names of additional, existing Hetzner firewalls to attach, e.g. one allowing your VPN's port
server_extra_firewalls: []

#----------------------------------------#
#          mailcow configuration         #
#----------------------------------------#
hostname: mail.example.com
# Server and mailserver timezone
timezone: Europe/Berlin
# mailcow branch to install and update: master (stable), nightly or legacy.
# Use a branch, not a release tag: mailcow's updater only works on a branch.
mailcow_branch: master
# Update mailcow on every playbook run. Otherwise update only when asked for (see README)
mailcow_install_updates: false
# Mailcow full text search
mailcow_fts: true
# Watchdog notification contact information
mailcow_watchdog_contact: monitoring@external.com

#----------------------------------------#
#           Backup configuration         #
#----------------------------------------#
# Whether backup using Borgbackup to an external server should be enabled
backup_enabled: true
# Passphrase for the Borgbackup repository (encrypted, see README)
backup_passphrase: !vault |
  $ANSIBLE_VAULT;1.1;AES256
  61393161336331353461353962616439383962333863613330663438383462313339633139363062
  3939383934303739633538396264316263353666656466640a376236323131373035613532633634
  61373664646366363630383836393765396230303933356462643931353065303836663532393230
  6232653335393261300a663336333766613164326230326133333933656366633131306362666138
  33386562313861343233626139646365383931646263646134633039303734353663356263666539
  3065653862313562306636323161613030633031393537613737
# SSH private key as base64 for connecting to the backup host (encrypted, see README)
backup_private_key: !vault |
  $ANSIBLE_VAULT;1.1;AES256
  37663439636638343036343437633231346133663634383234373533393235373261346162313262
  3534383136656339666236616466616139326139653536300a386238353231343136343164626435
  36663538306136613939393766316461366538343831613639356266383135643035313265313435
  3139333862343961630a323939646466383363346464346435653066306566663639306532636232
  33333338393039393037613339653638313431316164346633343637383839346465616632363630
  3338653430646463343265623931303735303537306366383666
# Backup server user (BorgBase: <repo_id>)
backup_user: u111111-sub1
# Backup server host (BorgBase: <repo_id>.repo.borgbase.com)
backup_host: u111111-sub1.your-storagebox.de
# Backup server ssh port (BorgBase: 22)
backup_port: 23
# SSH host keys of the backup server ("<type> <key>", e.g. from `ssh-keyscan -p 23 <host> | cut -d' ' -f2-`).
# If empty, the key is trusted on first connection and verified afterwards.
backup_host_keys:
  - ssh-ed25519 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Path of the Borgbackup repository at the backup server (BorgBase: ./repo)
backup_path: ./backups
# Whether the healtchecks.io (self-hosting supported) monitoring for the backup job should be enabled
backup_healthchecks_enabled: true
# Webhook of the configured healtchecks.io check
backup_healthchecks_webhook: https://hc-ping.com/11111111-1111-1111-1111-111111111111
# Makes the volumes writeable for Borgmatic to make restores possible. List can contain 'vmail', 'crypt', 'redis', 'rspamd', 'postfix'
backup_restorable: []
