network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      addresses:
      - {{ server_ipv4_address }}/32
      - {{ server_ipv6_address }}/64
{% if server_floating_ipv4_address %}
      - {{ server_floating_ipv4_address }}/32
{% endif %}
{% if server_floating_ipv6_address %}
      - {{ server_floating_ipv6_address }}/64
{% endif %}
      routes:
      - to: 0.0.0.0/0
        via: 172.31.1.1
        on-link: true
      - to: ::/0
        via: fe80::1
        on-link: true
      match:
        macaddress: {{ ansible_facts.default_ipv4.macaddress }}
      set-name: eth0
