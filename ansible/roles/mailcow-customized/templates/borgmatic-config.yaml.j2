source_directories:
  - /mnt/source/vmail
  - /mnt/source/crypt
  - /mnt/source/redis
  - /mnt/source/rspamd
  - /mnt/source/postfix
repositories:
  - path: ssh://{{ backup_user }}@{{ backup_host }}:{{ backup_port }}/{{ backup_path }}
exclude_patterns:
  - '/mnt/source/postfix/public/'
  - '/mnt/source/postfix/private/'
  - '/mnt/source/rspamd/rspamd.sock'

keep_hourly: 24
keep_daily: 7
keep_weekly: 4
keep_monthly: 6

mariadb_databases:
  - name: ${DBNAME}
    username: ${DBUSER}
    password: ${DBPASS}
    options: "--default-character-set=utf8mb4 --skip-ssl"
    list_options: "--skip-ssl"
    restore_options: "--skip-ssl"

# UpdateHostKeys=no keeps ssh from adding further host keys to the known_hosts file managed by Ansible
ssh_command: ssh -o StrictHostKeyChecking={{ 'yes' if backup_host_keys else 'accept-new' }} -o UpdateHostKeys=no

# Checks run with the hourly backup, but each only when its frequency has elapsed.
# "data" verifies chunk signatures and therefore detects tampering, but reads a lot of data.
checks:
    - name: repository
      frequency: 1 week
    - name: archives
      frequency: 1 week
    - name: data
      frequency: 1 month

check_last: 3

commands:
    - before: action
      when:
          - create
      run:
          - echo "`date` - Starting backup"
    - after: action
      when:
          - create
      run:
          - echo "`date` - Finished backup"

{% if backup_healthchecks_enabled %}
healthchecks:
  ping_url: {{ backup_healthchecks_webhook }}
  states:
    - finish
{% endif %}
