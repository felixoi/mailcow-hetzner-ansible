---
extends: default

ignore: |
  ansible/roles/mailcow/
  config.yml

rules:
  # Settings compatible with ansible-lint
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 160
